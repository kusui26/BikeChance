# apps/web のローカル開発用の雛形（W1 プラン §11.8）。
#
# Next.js は **アプリのディレクトリ直下の .env* だけ** を読み、リポジトリ直下の .env は
# 読まない。逆に Supabase CLI はリポジトリ直下で動く。用途で分ける。
#
#   apps/web/.env.local  … ローカル Supabase に向けた開発用（pnpm dev、ルートの手動実行）
#   .env（リポジトリ直下）… 本番の資格情報。supabase link / db push、本番への手動確認
#
# 使い方：
#   1. このファイルを apps/web/.env.local にコピーする
#   2. pnpm db:start を実行し、出力の API_URL と SECRET_KEY を貼る
#      （ローカルの鍵は全環境で同じ既定値で、秘密ではない）
#   3. ODPT_ACCESS_TOKEN はリポジトリ直下の .env から写す
#
# **このファイルに実際の値を書かないこと。** .env.local は git 管理外。

# ローカル Supabase（pnpm db:start の出力 API_URL）
SUPABASE_URL=
# ローカル Supabase の SECRET_KEY（sb_secret_... で始まる）
SUPABASE_SECRET_KEY=

# ODPT のアクセストークン。認証付きエンドポイントのクエリに載る（開発プラン D-04）
ODPT_ACCESS_TOKEN=

# ルートハンドラの認証。ローカルでは任意の文字列でよい
CRON_SECRET=

# ODPT の通知文と User-Agent に載せる連絡先
CONTACT_EMAIL=
