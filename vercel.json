{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "ml": {
      "root": "apps/ml",
      "framework": "fastapi",
      "functions": {
        "**/*.py": {
          "maxDuration": 120
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/ml/(.*)",
      "destination": {
        "service": "ml"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/jobs/collect/hellocycling",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/jobs/collect/docomo-cycle",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/jobs/sync-stations/hellocycling",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/jobs/sync-stations/docomo-cycle",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/jobs/archive-weather",
      "schedule": "17 * * * *"
    },
    {
      "path": "/ml/weather",
      "schedule": "25 * * * *"
    },
    {
      "path": "/ml/compact",
      "schedule": "7 * * * *"
    },
    {
      "path": "/ml/infer/hellocycling",
      "schedule": "4-59/5 * * * *"
    },
    {
      "path": "/ml/infer/docomo-cycle",
      "schedule": "1-59/5 * * * *"
    },
    {
      "path": "/ml/reference",
      "schedule": "0 20 * * *"
    }
  ]
}
