{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/jobs/collect/hellocycling",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/jobs/collect/docomo-cycle",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/jobs/sync-stations/hellocycling",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/jobs/sync-stations/docomo-cycle",
      "schedule": "0 19 * * *"
    }
  ]
}
